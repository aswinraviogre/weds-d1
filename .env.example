# ========================================================
# LUXURY WEDDING INVITATION CONFIGURATION
# Couple: Yaswanth Sai & Lakshmi Mrudula
# ========================================================

# Server Port
PORT=5000

# Admin Dashboard Passcode (protects /admin view)
ADMIN_PASSCODE=yashmrudula2026

# RSVP Notification Target Email
NOTIFICATION_EMAIL=aswinravi70@gmail.com

# --------------------------------------------------------
# OPTIONAL: Cloud Database (Supabase)
# If provided, RSVPs will be saved to Supabase PostgreSQL table.
# If omitted or left empty, the server automatically uses the
# local persistent SQLite/JSON store at data/wedding_rsvps.json
# --------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# --------------------------------------------------------
# OPTIONAL: Transactional Email Service (Resend)
# https://resend.com
# If provided, live emails are sent on every RSVP submission.
# If omitted or left empty, the server safely logs the full email
# payload and preserves the RSVP without errors.
# --------------------------------------------------------
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

